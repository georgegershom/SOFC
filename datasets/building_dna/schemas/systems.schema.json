{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Building Systems",
  "type": "object",
  "properties": {
    "hvac": {
      "type": "object",
      "properties": {
        "system_type": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "fuel_type": { "type": "string" },
        "age_years": { "type": "number", "minimum": 0 },
        "efficiency": { "type": "object", "properties": { "seer": { "type": "number" }, "afue": { "type": "number" }, "cop": { "type": "number" } }, "additionalProperties": false },
        "rated_capacity_kW": { "type": "number", "minimum": 0 },
        "maintenance_history": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["system_type", "fuel_type"]
    },
    "dhw": {
      "type": "object",
      "properties": {
        "system_type": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "fuel_type": { "type": "string" },
        "age_years": { "type": "number", "minimum": 0 },
        "efficiency": { "type": "object", "properties": { "uef": { "type": "number" }, "cop": { "type": "number" } }, "additionalProperties": false },
        "storage_volume_liters": { "type": "number", "minimum": 0 }
      },
      "required": ["system_type", "fuel_type"]
    },
    "lighting": {
      "type": "object",
      "properties": {
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": { "type": "string" },
              "lamp_type": { "type": "string" },
              "wattage_W": { "type": "number", "minimum": 0 },
              "control": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 }
            },
            "required": ["lamp_type", "wattage_W", "count"]
          }
        }
      },
      "required": ["fixtures"]
    },
    "renewables": {
      "type": "object",
      "properties": {
        "solar_pv": {
          "type": "object",
          "properties": {
            "capacity_kWp": { "type": "number", "minimum": 0 },
            "inverter_efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
            "age_years": { "type": "number", "minimum": 0 },
            "azimuth_deg": { "type": "number", "minimum": -180, "maximum": 180 },
            "tilt_deg": { "type": "number", "minimum": 0, "maximum": 90 }
          },
          "required": ["capacity_kWp"]
        },
        "solar_thermal": {
          "type": "object",
          "properties": {
            "area_m2": { "type": "number", "minimum": 0 },
            "efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
            "age_years": { "type": "number", "minimum": 0 },
            "azimuth_deg": { "type": "number", "minimum": -180, "maximum": 180 },
            "tilt_deg": { "type": "number", "minimum": 0, "maximum": 90 }
          },
          "required": ["area_m2"]
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["hvac", "dhw", "lighting", "renewables"]
}
