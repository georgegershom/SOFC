    },
    "thermal_expansion": {
      "columns": ["temperature_C", "cte_10minus6_per_K"],
      "description": "Coefficient of Thermal Expansion vs Temperature"
    },
    "creep_data": {
      "columns": ["time_seconds", "strain", "strain_rate_per_s", "stress_mpa", "temperature_C"],
      "description": "Creep strain vs time at constant stress and temperature"
    },
    "elastic_properties": {
      "columns": ["temperature_C", "relative_density", "youngs_modulus_gpa", "poissons_ratio"],
