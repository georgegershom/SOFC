    ],
    "air_content": [
      "Progressive increase in air content with rubber percentage",
      "Coarse rubber entrains slightly more air than fine rubber",
      "Maximum air content of 5.2% observed at 20% coarse rubber"
    ],
    "unit_weight": [
      "Linear decrease with rubber content",
      "Approximately 7.5% reduction at 20% rubber replacement",
      "Consistent with lower specific gravity of rubber"
    ],
    "bleeding": [
      "Reduced bleeding with increased rubber content",
      "Rubber particles help retain water in the mix",
      "Silica fume further reduces bleeding"
    ],
    "setting_time": [
      "Slight retardation with rubber addition",
      "Effect more pronounced with coarse rubber",
      "Silica fume reduces setting time delay"
    ],
    "rheology": [
      "Increased yield stress and plastic viscosity with rubber",
      "Non-linear relationship with rubber content",
      "Critical threshold appears around 15% replacement"
    ]
  }
