  "mixing_procedure": {
    "equipment": "Pan mixer - 100L capacity",
    "ambient_conditions": {
      "temperature": "23±2°C",
      "relative_humidity": "65±5%"
    },
    "sequence": [
      {
        "step": 1,
        "action": "Add coarse aggregate and 50% water",
        "duration": "30 seconds mixing"
      },
      {
        "step": 2,
        "action": "Add cement and fine aggregate",
        "duration": "30 seconds mixing"
      },
      {
        "step": 3,
        "action": "Add crumb rubber (if applicable)",
        "duration": "30 seconds mixing"
      },
      {
        "step": 4,
        "action": "Add remaining water with dissolved admixtures",
        "duration": "2 minutes mixing"
      },
      {
        "step": 5,
        "action": "Rest period",
        "duration": "3 minutes"
      },
      {
        "step": 6,
        "action": "Final mixing",
        "duration": "2 minutes"
      }
    ],
    "total_mixing_time": "8 minutes"
