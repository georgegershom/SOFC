{
  "dataset_name": "context_dataset",
  "dataset_version": "v1",
  "description": "Process, geometry, and material context parameters for residual stress prediction",
  "units_convention": "SI (thickness in \u00b5m; CTE in 1e-6/\u00b0C)",
  "fields": [
    {
      "name": "sample_id",
      "type": "integer",
      "units": "-",
      "description": "Sequential sample identifier starting at 0"
    },
    {
      "name": "random_seed",
      "type": "integer",
      "units": "-",
      "description": "Deterministic RNG seed used for this sample"
    },
    {
      "name": "doe_tag",
      "type": "string",
      "units": "-",
      "description": "Dataset/DOE tag for traceability"
    },
    {
      "name": "generated_timestamp_utc",
      "type": "string",
      "units": "ISO-8601",
      "description": "Generation timestamp (UTC)"
    },
    {
      "name": "plate_length_mm",
      "type": "number",
      "units": "mm",
      "description": "Final (sintered) plate length",
      "typical_range": [
        20.0,
        200.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "plate_width_mm",
      "type": "number",
      "units": "mm",
      "description": "Final (sintered) plate width (\u2264 length)",
      "typical_range": [
        10.0,
        200.0
      ],
      "allowed_values": "uniform_conditional"
    },
    {
      "name": "anode_thickness_um",
      "type": "number",
      "units": "\u00b5m",
      "description": "Anode layer thickness",
      "typical_range": [
        200.0,
        1200.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "electrolyte_thickness_um",
      "type": "number",
      "units": "\u00b5m",
      "description": "Electrolyte layer thickness",
      "typical_range": [
        5.0,
        50.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "cathode_thickness_um",
      "type": "number",
      "units": "\u00b5m",
      "description": "Cathode layer thickness",
      "typical_range": [
        20.0,
        150.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "green_length_mm",
      "type": "number",
      "units": "mm",
      "description": "Initial green tape length before sintering"
    },
    {
      "name": "green_width_mm",
      "type": "number",
      "units": "mm",
      "description": "Initial green tape width before sintering"
    },
    {
      "name": "green_density_frac_anode",
      "type": "number",
      "units": "-",
      "description": "Green relative density (anode)",
      "typical_range": [
        0.3,
        0.6
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "green_density_frac_electrolyte",
      "type": "number",
      "units": "-",
      "description": "Green relative density (electrolyte)",
      "typical_range": [
        0.35,
        0.7
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "green_density_frac_cathode",
      "type": "number",
      "units": "-",
      "description": "Green relative density (cathode)",
      "typical_range": [
        0.3,
        0.6
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_E0_GPa",
      "type": "number",
      "units": "GPa",
      "description": "Young's modulus at 25 \u00b0C (anode)",
      "typical_range": [
        50.0,
        200.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_E_slope_frac_per_C",
      "type": "number",
      "units": "1/\u00b0C",
      "description": "Fractional slope of E vs T (anode); typically negative",
      "typical_range": [
        -0.0006,
        -0.0001
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_E_1000C_GPa",
      "type": "number",
      "units": "GPa",
      "description": "Young's modulus at 1000 \u00b0C (anode)"
    },
    {
      "name": "anode_CTE_1e-6_per_C",
      "type": "number",
      "units": "1e-6/\u00b0C",
      "description": "CTE (anode)",
      "typical_range": [
        11.0,
        14.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_nu",
      "type": "number",
      "units": "-",
      "description": "Poisson's ratio (anode)",
      "typical_range": [
        0.2,
        0.32
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_shrinkage_onset_C",
      "type": "number",
      "units": "\u00b0C",
      "description": "Sintering shrinkage onset temperature (anode)",
      "typical_range": [
        650.0,
        900.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_shrinkage_rate_per_C",
      "type": "number",
      "units": "1/\u00b0C",
      "description": "Approx. linearized shrinkage rate parameter (anode)",
      "typical_range": [
        0.0001,
        0.005
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_final_linear_shrinkage_fraction",
      "type": "number",
      "units": "-",
      "description": "Final linear shrinkage fraction (anode)",
      "typical_range": [
        0.06,
        0.22
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_creep_A_1_per_s_MPa_pow_n",
      "type": "number",
      "units": "1/s/MPa^n",
      "description": "Norton creep prefactor A (anode)",
      "typical_range": [
        1e-25,
        1e-15
      ],
      "allowed_values": "loguniform"
    },
    {
      "name": "anode_creep_n",
      "type": "number",
      "units": "-",
      "description": "Norton creep stress exponent n (anode)",
      "typical_range": [
        2.0,
        5.0
      ],
      "allowed_values": "uniform"
    },
    {
      "name": "anode_creep_Q_kJ_per_mol",
      "type": "number",
      "units": "kJ/mol",
      "description": "Norton creep activation energy Q (anode)",
      "typical_range": [
        200.0,
        500.0
      ],
      "allowed_values": "uniform"
