    "stress_measurement": {
      "curvature_based_inverse_method": {
        "technique": "Curvature-Based Inverse Method (Stoney's Formula)",
        "equipment": "Profilometer + Custom curvature measurement setup",
        "principle": "Measure curvature of bilayer after layer deposition and sintering",
        "procedure": [
          "Prepare bilayer sample (electrolyte on anode)",
          "Measure initial flatness of substrate",
          "Deposit and sinter electrolyte layer",
          "Measure final curvature using profilometer",
          "Calculate stress using Stoney's formula",
          "Account for temperature-dependent properties",
          "Estimate uncertainty from measurement errors"
        ],
        "stoney_formula": "σ = (E_s * t_s²) / (6 * (1-ν_s) * t_f) * (1/R_f - 1/R_i)",
        "parameters": {
          "substrate_thickness": "300 μm",
          "film_thickness": "50-300 μm",
          "substrate_modulus": "170 GPa (YSZ)",
