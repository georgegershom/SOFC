        "flow_configuration",
        "attenuation_db_per_m",
        "gas_fraction",
        "interface_roughness_mm",
        "reynolds_number_gas",
        "weber_number",
        "froude_number",
        "temperature_c",
        "pressure_bar"
      ],
      "applications": [
