{
  "dataset_metadata": {
    "title": "Fire-Resistant Rubberized Concrete Dataset - Phase 1: Material Characterization & Specimen Preparation",
    "version": "1.0",
    "creation_date": "2024-10-18",
    "last_modified": "2024-10-18",
    "description": "Comprehensive dataset for research on fire-resistant structural elements utilizing high-performance rubberized concrete incorporating crumb rubber from recycled tires",
    "research_context": {
      "project_title": "Development and Validation of a Thermo-Mechanical Model for Fire-Resistant Structural Elements Utilizing High-Performance Rubberized Concrete",
      "phase": "Phase 1 - Material Characterization & Specimen Preparation",
      "research_objectives": [
        "Characterize constituent materials for rubberized concrete",
        "Develop optimized mix designs with varying rubber content",
        "Evaluate fresh concrete properties and workability",
        "Establish baseline data for thermo-mechanical modeling",
        "Support fire resistance research applications"
      ]
    },
    "dataset_structure": {
      "total_files": 8,
      "total_size_mb": 2.5,
      "data_format": "JSON",
      "analysis_format": "Python (pandas, matplotlib, plotly)",
      "directories": {
        "01_constituent_materials": {
          "description": "Raw material characterization data",
          "files": 4,
          "content": "Cement, aggregates, crumb rubber, water & admixtures"
        },
        "02_mix_designs": {
          "description": "Mix proportion matrices",
          "files": 1,
          "content": "Complete mix design database with 12 distinct formulations"
        },
        "03_fresh_properties": {
