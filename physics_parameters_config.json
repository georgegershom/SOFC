  "boundary_conditions": {
    "thermal": {
      "insulated": {
        "type": "Neumann",
        "description": "绝热边界（热流为0）",
        "equation": "-k·∇T·n = 0"
      },
      "convective": {
        "type": "Robin",
        "description": "对流边界",
        "equation": "-k·∇T·n = h·(T - T_ambient)",
        "typical_values": {
          "h_natural": {
            "value": 10.0,
            "unit": "W/(m²·K)",
            "description": "自然对流换热系数"
          },
          "h_forced": {
            "value": 100.0,
            "unit": "W/(m²·K)",
            "description": "强制对流换热系数"
          },
          "T_ambient": {
            "value": 298.15,
            "unit": "K",
            "description": "环境温度"
          }
        }
      },
      "fixed_temperature": {
        "type": "Dirichlet",
        "description": "固定温度边界",
        "equation": "T = T_fixed",
        "typical_values": {
          "T_fixed": {
            "value": 298.15,
            "unit": "K"
          }
        }
      }
    },
    
    "mechanical": {
      "fixed_displacement": {
        "type": "Dirichlet",
        "description": "固定位移边界（完全固定）",
        "equation": "u = 0, v = 0, w = 0"
      },
      "traction_free": {
        "type": "Neumann",
        "description": "自由边界（应力为0）",
        "equation": "σ·n = 0"
      },
      "symmetry": {
        "type": "Mixed",
        "description": "对称边界",
        "equation": "u_n = 0, σ_t = 0"
      }
    },
    
    "electrical": {
      "applied_potential": {
        "type": "Dirichlet",
        "description": "施加电位",
        "equation": "φ = φ_applied",
        "typical_values": {
          "phi_anode": {
            "value": 0.0,
            "unit": "V",
            "description": "负极电位（参考）"
          },
          "phi_cathode": {
            "value": 4.2,
            "unit": "V",
            "description": "正极电位（充满电）"
          }
        }
      },
      "applied_current": {
        "type": "Neumann",
        "description": "施加电流",
        "equation": "-σ·∇φ·n = j_applied",
        "typical_values": {
          "I_charge_1C": {
            "value": 2.5,
            "unit": "A",
            "description": "1C充电电流（2.5Ah电池）"
