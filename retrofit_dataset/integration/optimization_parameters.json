        "target_value": 8.0,
        "constraint_type": "inequality",
        "constraint_value": 12.0
      },
      "carbon_emissions": {
        "weight": 0.25,
        "minimize": true,
        "target_units": "kg_CO2e_per_sqft_per_year",
